# -- Server config --
# Path to your server definitions (default ./mcp.json, copied from mcp.example.json)
# MCP_CONFIG=./mcp.json

# -- MCP server tokens (only the servers enabled in your config need values) --
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-personal-access-token
SENTRY_AUTH_TOKEN=sntryu_your-sentry-user-auth-token
SENTRY_HOST=your-org.sentry.io
SHORTCUT_API_TOKEN=your-shortcut-api-token
NOTION_TOKEN=ntn_your-notion-internal-integration-token
SEMAPHORE_MCP_TOKEN=your-semaphore-mcp-token
NEW_RELIC_API_KEY=NRAK-your-new-relic-api-key
NEW_RELIC_ACCOUNT_ID=your-new-relic-account-id
SLACK_MCP_CLIENT_ID=your-slack-app-client-id
SLACK_MCP_CLIENT_SECRET=your-slack-app-client-secret
REPLICA_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=no-verify
# Optional host script that opens the replica tunnel before the stack starts (not passed to containers)
# DATA_RO_CONNECT=/absolute/path/to/tunnel-script.sh

# -- Proxy auth --
# Clients send this as "Authorization: Bearer <token>". Generate with: openssl rand -hex 32
MCP_PROXY_TOKEN=your-proxy-bearer-token
# Keep false in token mode; set true only with the OAuth nginx template (see README)
ONE_MCP_ENABLE_AUTH=false

# -- Ports & URL --
ONE_MCP_PORT=3050
PROXY_EXTERNAL_PORT=9494
ONE_MCP_EXTERNAL_URL=http://127.0.0.1:9494

# -- Agent tuning --
# ONE_MCP_LOG_LEVEL=info
# ONE_MCP_ENABLE_ENV_SUBSTITUTION=true
ONE_MCP_ENABLE_CONFIG_RELOAD=true
ONE_MCP_ENABLE_ASYNC_LOADING=true
# ONE_MCP_TRUST_PROXY=uniquelocal
